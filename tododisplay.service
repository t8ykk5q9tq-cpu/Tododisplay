[Unit]
Description=Todo Display Board
After=network.target graphical.target
Wants=graphical.target

[Service]
Type=simple
User=matt
WorkingDirectory=/home/matt/Tododisplay
ExecStart=/home/matt/Tododisplay/start.sh
ExecStop=/home/matt/Tododisplay/stop.sh
Restart=on-failure
RestartSec=5
Environment=DISPLAY=:0

[Install]
WantedBy=graphical.target
